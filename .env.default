# Application Configuration
PORT=3000
NODE_ENV=development
SECRET=secret

# Inbound rate limiting, enforced by protect(). Requests carrying a valid API key are counted against
# the key; everything else is counted against the caller's address.
# Per API key, per minute. Leave unset to default to WHATSAPP_THROUGHPUT_MPS * 60 * 1.25 (6000 at 80
# mps): every send is one request, so a client must be able to ask for at least the messages Meta will
# accept from it, plus headroom for status polling, media and template calls. Nothing here lets a
# client past Meta — a send over the throughput bucket is queued, not sent.
CLIENT_RATE_LIMIT=
# Per address, per minute, for requests with no usable key. This is the ceiling on probing, not on
# use; five failed attempts still block an address for 15 minutes.
RATE_LIMIT=100
# How many proxies of ours sit in front of this server, and so how many entries at the END of
# x-forwarded-for we wrote rather than the caller. The leftmost entry is whatever the caller sent, so
# counting from the left lets anyone choose the address their limits and blocks are counted under.
# Set to 0 when the server is reachable directly, which ignores the header entirely.
TRUSTED_PROXY_HOPS=1

# Mirrors of Meta's own quotas — see src/limits.ts. Leave these alone unless Meta has told you the
# account's allowances differ; raising them past what Meta grants only moves the rejection to Graph.
# Messages per second per business phone number (Meta's default is 80, upgradable to 1000)
WHATSAPP_THROUGHPUT_MPS=80
# Burst allowance towards a single recipient before the 1-per-6-seconds pair limit bites
WHATSAPP_PAIR_BURST=45
# WhatsApp Business Management calls per hour per client; Meta cuts an active WABA off at 5000
WABA_RATE_LIMIT=4500
# Percentage of a Graph quota at which X-Business-Use-Case-Usage starts producing warnings
GRAPH_USAGE_WARN_PERCENT=90

FILE_UPLOAD_DIR=files/
# Where the OpenAPI specification is written on start-up
OPENAPI_FILE=openapi.yaml

# Redis — required. Holds the rate-limit counters and the retry queue, so both are shared between
# replicas and survive a restart. `bun run docker` starts one; point this at it for local runs.
REDIS_URL=redis://localhost:6379
# Prefix for every key, so one Redis can be shared between environments
REDIS_PREFIX=msgsrv

# Retry queue
RETRY_MAX_ATTEMPTS=6
RETRY_BASE_DELAY_MS=5000
RETRY_MAX_DELAY_MS=900000
# Most jobs a single client may have pending before further work is refused with a 429. Read as drain
# time: at 80 messages/second this is a bit over two minutes of backlog.
RETRY_QUEUE_MAX=10000
RETRY_POLL_MS=1000
# Jobs claimed per poll, and how many of them run at once. Sized so one tick can carry a full second
# of throughput; concurrency does not decide the send rate, since every queued send re-checks the
# throughput bucket before it goes out.
RETRY_CLAIM_BATCH=80
RETRY_CONCURRENCY=8

# Consent holds
# Seconds a message waits for the customer to grant consent before it is given up on and reported
# failed. Not a retry: nothing about waiting for a person clears on a backoff curve.
CONSENT_HOLD_TTL=86400
# Seconds an unanswered consent request suppresses the next one. Re-asking resets the reply thread
# and costs another marketing template, so a burst of sends produces one request, not one each.
CONSENT_REQUEST_RESEND=86400

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=messages
DB_USER=postgres
DB_PASSWORD=password

# Facebook Configuration
APP_ID=your_app_id
VERIFY_TOKEN=your_verify_token
APP_SECRET=your_APP_SECRET
FB_CONFIG_ID=your_FB_CONFIG_ID

WHATSAPP_SYSTEM_TOKEN=
# End-to-end smoke tests (tests/e2e) — leave E2E_API_KEY empty to skip them
E2E_BASE_URL=http://localhost:3000
E2E_API_KEY=
